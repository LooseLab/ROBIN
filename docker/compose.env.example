# Copy to .env next to docker-compose.yml.
# ROBIN_WORK and ROBIN_REFERENCE must match work_dir / reference in ROBIN_TOML
# so the container sees the same absolute paths as a native run.

ROBIN_TOML=./rcns2_new.workflow-settings.toml
ROBIN_WORK=/Users/mattloose/GIT/REF_SAMPLES_NEW
# Directory that contains the FASTA and its .fai (must match the TOML reference path).
ROBIN_REFERENCE_DIR=/Users/mattloose/references
ROBIN_ADMIN_PASSWORD=change-me-now
ROBIN_GUI_PORT=8081
ROBIN_RAY_DASHBOARD_PORT=8265
# ROBIN_SKIP_MODEL_CHECK=1
# ROBIN_GIT_COMMIT=
